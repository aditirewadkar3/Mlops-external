pipeline {
    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                bat 'pip install -r requirements.txt'
            }
        }

        stage('Run Python Program') {
            steps {
                bat 'python -c "print(10 + 20)"'
            }
        }

        stage('Run Pytest') {
            steps {
                bat 'pytest -v'
            }
        }
    }
}